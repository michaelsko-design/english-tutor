{
  "name": "english-tutor-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-english-vibe \"playwright test\"",
    "test:e2e:headed": "firebase emulators:exec --only auth,firestore --project demo-english-vibe \"playwright test --headed --project=desktop\"",
    "dev:emu": "vite --mode emulator",
    "tts:corpus": "vite-node scripts/tts/collectCorpus.ts",
    "tts:render": "vite-node scripts/tts/renderClips.ts --",
    "tts:check": "vite-node scripts/tts/checkClips.ts --",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-english-vibe --import=.emulator-data --export-on-exit",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "tts:render:he": "vite-node scripts/tts/renderGeminiBatch.ts --"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.3",
    "vite-node": "^3.2.4",
    "vitest": "^5.0.5"
  }
}
