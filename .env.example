# Firebase Client Configuration (Copy this file to .env and fill in your Firebase Web App values)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase App Check (reCAPTCHA Enterprise site key). Leave empty to run without App Check.
VITE_APPCHECK_SITE_KEY=

# Server only (Vercel env): set to "on" once the Firebase console shows the web app sending valid
# App Check tokens, so /api/tts refuses requests without one. FIREBASE_PROJECT_NUMBER is the first
# part of the web appId (defaults to this project's).
# APPCHECK_ENFORCE=on

# Azure Speech (server only, no VITE_ prefix): the /api/tts online voice and npm run tts:render.
# Put real values in .env.local and in the Vercel project's environment variables.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=germanywestcentral

# Where the read-aloud mp3 clips are served from (Cloudflare R2 bucket public URL, no trailing slash).
# Leave empty to serve them from /tts/ on the app itself. Upload with: npm run tts:upload
VITE_TTS_CLIP_BASE_URL=
# R2 upload credentials for npm run tts:upload (local only, never a VITE_ variable)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Streak reminders (Web Push + hourly cron). Generate the pair with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY is also read by the cron; the rest is server only (Vercel env).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
# Owner dashboard (/?owner): the Firebase uid of the owner's Google account (Firebase console > Authentication)
OWNER_UID=

# EnglishVibe Pro payments (server only, Vercel env; docs/feature-pro-tier.md). PAYMENT_PROVIDER is
# "grow" or "mock" (the stand-in gateway; local runs with a demo- FIREBASE_PROJECT_ID only). FIREBASE_SERVICE_ACCOUNT_JSON (as for
# the parent PIN reset) writes the entitlements. PAYMENT_WEBHOOK_SECRET is a long random string that the
# webhook URLs carry. APP_ORIGIN is the https origin Grow sends parents back to.
# PAYMENT_PROVIDER=mock
# PAYMENT_WEBHOOK_SECRET=
# APP_ORIGIN=https://your-app.example
# Grow (Meshulam): ids from Grow support; GROW_ENV=production only with the live ids.
# GROW_ENV=sandbox
# GROW_USER_ID=
# GROW_RECURRING_PAGE_CODE=
# GROW_REGULAR_PAGE_CODE=
# GROW_API_KEY=
# GROW_WEBHOOK_KEY=
